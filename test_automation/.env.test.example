# SmartBizz POS — Test Automation Environment
# Copy this to .env.test and fill in real values
# NEVER commit .env.test to git

# ── Base URLs ──
BASE_URL=https://smartbizz.devmonks.space

# ── Platform Admin (MASTER_ADMIN) ──
ADMIN_EMAIL=smartdine.platform@gmail.com
ADMIN_PASSWORD=REPLACE_WITH_REAL_ADMIN_PASSWORD

# ── Test Tenant: Restaurant (created fresh for each test run) ──
TEST_RESTAURANT_EMAIL=zz-test-restaurant@devmonks.space
TEST_RESTAURANT_PASSWORD=REPLACE_WITH_TEST_PASSWORD
TEST_RESTAURANT_ORG_ID=ZZ_TEST_RESTAURANT

# ── Test Tenant: Kirana ──
TEST_KIRANA_EMAIL=zz-test-kirana@devmonks.space
TEST_KIRANA_PASSWORD=REPLACE_WITH_TEST_PASSWORD
TEST_KIRANA_ORG_ID=ZZ_TEST_KIRANA

# ── Test Tenant: Pharmacy ──
TEST_PHARMACY_EMAIL=zz-test-pharmacy@devmonks.space
TEST_PHARMACY_PASSWORD=REPLACE_WITH_TEST_PASSWORD
TEST_PHARMACY_ORG_ID=ZZ_TEST_PHARMACY

# ── Test Tenant: Supermarket ──
TEST_SUPERMARKET_EMAIL=zz-test-supermarket@devmonks.space
TEST_SUPERMARKET_PASSWORD=REPLACE_WITH_TEST_PASSWORD
TEST_SUPERMARKET_ORG_ID=ZZ_TEST_SUPERMARKET

# ── Staff accounts (created under restaurant tenant) ──
TEST_MANAGER_EMAIL=zz-manager@devmonks.space
TEST_MANAGER_PASSWORD=REPLACE_WITH_TEST_PASSWORD
TEST_BILLING_EMAIL=zz-billing@devmonks.space
TEST_BILLING_PASSWORD=REPLACE_WITH_TEST_PASSWORD
TEST_WAITER_EMAIL=zz-waiter@devmonks.space
TEST_WAITER_PASSWORD=REPLACE_WITH_TEST_PASSWORD
TEST_KITCHEN_EMAIL=zz-kitchen@devmonks.space
TEST_KITCHEN_PASSWORD=REPLACE_WITH_TEST_PASSWORD

# ── Demo org for guest QR (read-only, public) ──
DEMO_ORG_ID=DEMO

# ── Timeouts (ms) ──
FLUTTER_BOOT_TIMEOUT=15000
ACTION_TIMEOUT=10000
