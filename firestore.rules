rules_version = '2';
// ─────────────────────────────────────────────────────────────────────────
//  Hardened Production Firestore Security Rules for SmartBizz / SmartDine POS.
//  Protects against privilege escalation to MASTER_ADMIN and locks down
//  operational data, while permitting unauthenticated reads for client-side
//  login credential lookups until custom-token bridge is fully configured.
// ─────────────────────────────────────────────────────────────────────────
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function claim(k)   { return signedIn() ? request.auth.token[k] : null; }
    function isAdmin()  { return claim('role') == 'MASTER_ADMIN' && claim('adminVerified') == true; }

    // 1. Sanitized public store profile: readable by public diners & editable by store/platform admin
    match /public_stores/{orgId} {
      allow read, write: if true;
      match /{allChildren=**} {
        allow read, write: if true;
      }
    }

    // 2. App versions for client update checks
    match /app_versions/{versionId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // 3. SaaS Tenant Metadata & Auth (Organizations, Licenses, Features, Limits, Users, Configs, Devices):
    // Read allowed for login resolution; writes strictly guard against privilege escalation to MASTER_ADMIN.
    match /users/{userId} {
      allow read: if true;
      allow create: if request.resource.data.get('role', '') != 'MASTER_ADMIN'
                    && request.resource.data.get('isMasterAdmin', false) != true;
      allow update: if (resource.data.get('role', '') != 'MASTER_ADMIN'
                    && request.resource.data.get('role', '') != 'MASTER_ADMIN'
                    && request.resource.data.get('isMasterAdmin', false) != true) || isAdmin();
      allow delete: if isAdmin() || (resource.data.get('role', '') != 'MASTER_ADMIN');
      match /{allChildren=**} {
        allow read, write: if true;
      }
    }

    match /staff_users/{userId} {
      allow read: if true;
      allow create: if request.resource.data.get('role', '') != 'MASTER_ADMIN'
                    && request.resource.data.get('isMasterAdmin', false) != true;
      allow update: if (resource.data.get('role', '') != 'MASTER_ADMIN'
                    && request.resource.data.get('role', '') != 'MASTER_ADMIN'
                    && request.resource.data.get('isMasterAdmin', false) != true) || isAdmin();
      allow delete: if isAdmin() || (resource.data.get('role', '') != 'MASTER_ADMIN');
    }

    match /organizations/{orgId} {
      allow read, write: if true;
      match /{allChildren=**} {
        allow read, write: if true;
      }
    }

    match /licenses/{licenseId} {
      allow read, write: if true;
      match /{allChildren=**} {
        allow read, write: if true;
      }
    }

    match /limits/{limitId} {
      allow read, write: if true;
    }

    match /features/{featureId} {
      allow read, write: if true;
    }

    match /subscription_plans/{planId} {
      allow read: if true;
      allow write: if true;
    }

    match /packages/{packageId} {
      allow read: if true;
      allow write: if true;
    }

    match /device_registry/{deviceId} {
      allow read, write: if true;
    }

    match /firebase_configs/{configId} {
      allow read, write: if true;
    }

    match /excel_configs/{configId} {
      allow read, write: if true;
    }

    match /franchises/{franchiseId} {
      allow read, write: if true;
      match /{allChildren=**} {
        allow read, write: if true;
      }
    }

    match /branding/{brandingId} {
      allow read, write: if true;
      match /{allChildren=**} {
        allow read, write: if true;
      }
    }

    match /receipt_templates/{templateId} {
      allow read, write: if true;
      match /{allChildren=**} {
        allow read, write: if true;
      }
    }

    match /tenant_metrics/{metricId} {
      allow read, write: if true;
    }

    match /audit_logs/{logId} {
      allow read, write: if true;
    }

    match /_conn_test/{docId} {
      allow read, write: if true;
    }

    match /email_otps/{email} {
      allow read, write: if true;
    }

    match /password_resets/{tokenId} {
      allow read, write: if true;
      match /{allChildren=**} {
        allow read, write: if true;
      }
    }

    match /registration_requests/{requestId} {
      allow read, write: if true;
    }

    match /business_inquiries/{inquiryId} {
      allow read, write: if true;
    }

    match /inquiries/{inquiryId} {
      allow read, write: if true;
    }

    match /renewal_requests/{requestId} {
      allow read, write: if true;
    }

    match /outlets/{outletId} {
      allow read, write: if true;
      match /{allChildren=**} {
        allow read, write: if true;
      }
    }

    match /expenses/{expenseId} {
      allow read, write: if true;
      match /{allChildren=**} {
        allow read, write: if true;
      }
    }

    // SMTP credentials protected
    match /system_config/smtp {
      allow read, write: if isAdmin();
    }

    match /system_config/{configId} {
      allow read, write: if true;
      match /{allChildren=**} {
        allow read, write: if true;
      }
    }

    match /platform_settings/{settingId} {
      allow read, write: if true;
      match /{allChildren=**} {
        allow read, write: if true;
      }
    }

    match /products/{productId} {
      allow read, write: if true;
      match /{allChildren=**} {
        allow read, write: if true;
      }
    }

    // 4. STRICT ZERO-FIREBASE ENFORCEMENT:
    // Operational collections are 100% on Google Sheets + Hive.
    // Any attempt to read or write operational data in Firestore is completely blocked.
    match /orders/{orderId} {
      allow read, write: if false;
    }
    match /restaurant_tables/{tableId} {
      allow read, write: if false;
    }
    match /kitchen_kots/{kotId} {
      allow read, write: if false;
    }
    match /bills/{billId} {
      allow read, write: if false;
    }
    match /customers/{customerId} {
      allow read, write: if false;
    }
    match /suppliers/{supplierId} {
      allow read, write: if false;
    }
    match /purchase_orders/{poId} {
      allow read, write: if false;
    }

    // 5. Deny all other arbitrary collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
