rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Sanitized public store profile: strictly public read-only
    match /public_stores/{orgId} {
      allow read: if true;
      allow write: if false;
    }

    // 2. App versions for client update checks: read-only
    match /app_versions/{versionId} {
      allow read: if true;
      allow write: if false;
    }
    
    // 3. SaaS Tenant Metadata (Organizations, Licenses, Features, Users): Read-only for client
    match /organizations/{orgId} {
      allow read: if true;
      allow write: if false;
      
      match /{allChildren=**} {
        allow read: if true;
        allow write: if false;
      }
    }

    match /licenses/{licenseId} {
      allow read: if true;
      allow write: if false;
    }

    match /features/{orgId} {
      allow read: if true;
      allow write: if false;
    }

    match /users/{userId} {
      allow read: if true;
      allow write: if false;
    }
    
    // 4. System config (SMTP, Razorpay secrets): Deny all direct client access
    match /system_config/{configId} {
      allow read, write: if false;
    }

    // 5. Deny all other operational and arbitrary collections (orders, tables, etc.)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

