{
  "functions": {
    "source": "functions"
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "database": {
    "rules": "database.rules.json"
  },
  "hosting": {
    "site": "smartdine-pos",
    "public": "hosting_public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/*.exe"
    ],
    "rewrites": [
      {
        "source": "/pos",
        "destination": "/pos/index.html"
      },
      {
        "source": "/pos/**",
        "destination": "/pos/index.html"
      },
      {
        "source": "/r",
        "destination": "/r/index.html"
      },
      {
        "source": "/r/**",
        "destination": "/r/index.html"
      },
      {
        "source": "/m/**",
        "destination": "/r/index.html"
      },
      {
        "source": "/m",
        "destination": "/r/index.html"
      }
    ],
    "headers": [
      {
        "source": "/pos/@(index.html|flutter_bootstrap.js|flutter_service_worker.js|version.json|main.dart.js|flutter.js|manifest.json)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/pos",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}
